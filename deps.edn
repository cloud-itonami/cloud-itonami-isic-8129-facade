{:paths ["src"]
 :deps {
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.langgraph"}
        ;; base design system for the build-time operator console
        ;; (`facadecleaningops.render-html`). AGENTS.md's "UI/UX 標準"
        ;; makes jp-go-dds (デジタル庁デザインシステム) the base design
        ;; system for any UI in this workspace; `:dev` below overrides it
        ;; to the local monorepo checkout so the console renders offline.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev -- pin to the local monorepo checkout so this
  ;; repo's own tests exercise the same langgraph/langchain source the
  ;; rest of the com-junkawasaki fleet builds against, instead of the
  ;; git/sha-pinned base deps above (which still work standalone outside
  ;; this monorepo). Note: `kotoba-lang/langgraph` is the current,
  ;; west-registered, renamed coordinate (per AGENTS.md's "Repo naming
  ;; -- no -clj suffix" ADR, 2026-07-10); `com-junkawasaki/langgraph-clj`
  ;; is the historical pre-rename name and is deliberately NOT used here.
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/jp-go-digital-design-system
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.jpGoDigitalDesignSystem"}}}
  :run {:main-opts ["-m" "facadecleaningops.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor
  ;; (operation -> governor -> store). Refuses to write unless the run
  ;; actually produced governor HARD refusals; see the namespace.
  :render-html {:main-opts ["-m" "facadecleaningops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
